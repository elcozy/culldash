# Copy to .env and fill in. Only scripts/package.sh reads this, and only when
# you are signing a build to hand to someone else; building and running the app
# locally needs none of it.
#
#     cp .env.example .env
#
# .env is gitignored: these name a certificate and a keychain profile, so they
# are not secrets on their own, but the account they belong to is yours.

# A Developer ID certificate from a paid Apple Developer account, written
# exactly as the keychain lists it. See what you have with:
#
#     security find-identity -v -p codesigning
#
# Leave this empty and the app is ad-hoc signed: it runs on the Mac that built
# it, and anyone else has to strip the quarantine flag by hand first. See
# "Send it to someone to test" in README.md.
DEVELOPER_ID="Developer ID Application: Your Name (TEAMID)"

# A notarytool keychain profile, set up once with:
#
#     xcrun notarytool store-credentials culldash \
#       --apple-id you@example.com \
#       --team-id TEAMID \
#       --password <app-specific-password>
#
# The password is an app-specific one from appleid.apple.com, never your Apple
# ID password. The profile keeps it in the keychain, which is why only its name
# appears here.
#
# With this set the DMG is notarized and stapled, and opens on any Mac with no
# warning. Without it, a signed build still warns on first open.
NOTARY_PROFILE=culldash
